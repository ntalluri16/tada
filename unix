import java.io.IOException;
import java.nio.file.*;
import java.nio.file.attribute.*;
import java.util.Set;
import java.util.stream.Stream;

public class FileInfo {

    public static void main(String[] args) throws IOException {
        Path path = Path.of("example.txt");

        printPermissions(path);
        printTopLines(path, 20);
    }

    static void printPermissions(Path path) throws IOException {
        System.out.println("=== File Permissions ===");

        FileStore store = Files.getFileStore(path);
        boolean posixSupported = store.supportsFileAttributeView(PosixFileAttributeView.class);

        if (posixSupported) {
            PosixFileAttributes attrs = Files.readAttributes(path, PosixFileAttributes.class);
            Set<PosixFilePermission> perms = attrs.permissions();

            System.out.println("POSIX: " + PosixFilePermissions.toString(perms));
            System.out.println("Owner: " + attrs.owner().getName());
            System.out.println("Group: " + attrs.group().getName());
        } else {
            System.out.println("Readable: " + Files.isReadable(path));
            System.out.println("Writable: " + Files.isWritable(path));
            System.out.println("Executable: " + Files.isExecutable(path));
        }

        System.out.println("Size: " + Files.size(path) + " bytes");
        System.out.println("Last modified: " + Files.getLastModifiedTime(path));
    }

    static void printTopLines(Path path, int maxLines) throws IOException {
        System.out.println("\n=== First " + maxLines + " lines ===");

        try (Stream<String> lines = Files.lines(path)) {
            lines.limit(maxLines).forEach(System.out::println);
        }
    }
}
